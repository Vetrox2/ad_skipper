# Copy as .env and fill in the values.

# Agent directory with config.json and best.pt (default: models)
AD_SKIPPER_AGENT_DIR=models/badoo

# Optional direct path to model weights, overrides model from agent's config.json (default: none)
AD_SKIPPER_MODEL_PATH=

AD_SKIPPER_ADB_ADDRESS=127.0.0.1:5555

# Confidence threshold for YOLO detection
AD_SKIPPER_CONF_THRESHOLD=0.3

# Scan interval in seconds (default: 2.0)
AD_SKIPPER_SCAN_INTERVAL=2.0

AD_SKIPPER_CLICK_COOLDOWN=4.0

# Number of times the same click is repeated before we consider it a loop
AD_SKIPPER_ANOMALY_REPEATS=5
AD_SKIPPER_ANOMALY_PAUSE=10.0

# Enable detailed logs DEBUG: true/false (default: false)
AD_SKIPPER_VERBOSE=false
